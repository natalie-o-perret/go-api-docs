// markdownlint configuration
// https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
{
  // Allow long lines — tables and URLs make strict wrapping impractical
  "MD013": false,

  // Allow inline HTML (badges, admonitions, etc.)
  "MD033": false,

  // Allow duplicate headings in different sections
  "MD024": { "siblings_only": true },

  // Allow trailing punctuation in headings
  "MD026": false,

  // Allow multiple top-level headings
  "MD025": false,

  // Don't require a top-level heading as the first line —
  // issue/PR templates use front matter and bold section headers
  "MD041": false,

  // Allow emphasis used as heading (issue templates use **bold** section headers)
  "MD036": false,

  // Fenced code blocks: don't require a language tag
  "MD040": false,

  // Table column alignment — unenforceable when cells contain long prose/URLs
  "MD060": false
}
